<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed by MiroLauncherActivity (HOME launcher) to write secure settings
         and re-enable the a11y service after boot. Granted via ADB:
         pm grant com.miro.a11y android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <!-- POST_NOTIFICATIONS required on Android 13+ to show the
         "Cerrar recientes" persistent notification (RecentTasksNotifier). -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miro"
        android:directBootAware="true"
        tools:targetApi="31">

        <!-- Launcher activity: ALSO acts as the home launcher so the system
             launches it automatically after every boot (the only user-app
             component Android starts on its own post-reboot on this ROM).
             On boot it re-enables the a11y service and hands control to the
             real launcher (ESLauncher). -->
        <activity
            android:name=".MiroLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: UI for Wireless Debugging setup (btnSetupAdb).
             No LAUNCHER intent-filter: it would create a second icon in
             the app drawer (the user reported two "miro" entries). The
             activity is still reachable via `am start -n com.miro.a11y/.ui.MainActivity`
             from the PC or from the MiroLauncherActivity itself if needed. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Miro" />

        <!-- MiroAccessibilityService: the actual a11y service. -->
        <service
            android:name=".MiroAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- MiroAccessibilityService: the single accessibility service.
             Wireless debug state machine lives inside this class via
             WirelessDebugAutomator (audit 2026-09-01: ONE service only). -->

    </application>

</manifest>
