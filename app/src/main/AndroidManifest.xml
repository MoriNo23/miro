<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed by MiroLauncherActivity (HOME launcher) to write secure settings
         and re-enable the a11y service after boot. Granted via ADB:
         pm grant com.miro.a11y android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <!-- POST_NOTIFICATIONS required on Android 13+ to show the
         "Cerrar recientes" persistent notification (RecentTasksNotifier). -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required by RecentsOverviewActivity (v1.4.22+) to list the
         running tasks. Deprecated on API 21+ but still functional
         for what we need (a partial list of foreground + visible
         tasks). -->
    <uses-permission
        android:name="android.permission.GET_TASKS" />
    <!-- Required to actually kill background processes from the
         AccessibilityService callback. protectionLevel: normal,
         granted at install time, no runtime prompt needed. -->
    <uses-permission
        android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".MiroApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miro"
        android:directBootAware="true"
        tools:targetApi="31">

        <!-- Launcher activity: ALSO acts as the home launcher so the system
             launches it automatically after every boot (the only user-app
             component Android starts on its own post-reboot on this ROM).
             On boot it re-enables the a11y service and hands control to the
             real launcher (ESLauncher). -->
        <activity
            android:name=".MiroLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: UI for Wireless Debugging setup (btnSetupAdb).
             No LAUNCHER intent-filter: it would create a second icon in
             the app drawer (the user reported two "miro" entries). The
             activity is still reachable via `am start -n com.miro.a11y/.ui.MainActivity`
             from the PC or from the MiroLauncherActivity itself if needed. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Miro" />

        <!-- MiroAccessibilityService: the actual a11y service. -->
        <service
            android:name=".MiroAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- WirelessDebugTileService: Quick Settings tile for the
             auto-start wireless debug flow. The user can add it
             to the QS panel via long-press on QS > edit. Tapping
             the tile toggles MiroAccessibilityService.kAutoStartWirelessDebug
             so the QS-tile wireless debug flow does NOT run on
             onServiceConnected() if the user disabled it. -->
        <service
            android:name=".WirelessDebugTileService"
            android:exported="true"
            android:label="@string/tile_wireless_debug"
            android:icon="@android:drawable/ic_menu_view"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- MiroAccessibilityService: the single accessibility service.
             Wireless debug state machine lives inside this class via
             WirelessDebugAutomator (audit 2026-09-01: ONE service only). -->

        <!-- RecentsActionActivity (v1.4.21+): destination for the two
             notification action buttons ("Abrir recientes", "Cerrar
             recientes"). Replaces the pre-1.4.21 BroadcastReceiver path
             which was blocked by Android 12's notification trampoline
             restriction (a receiver cannot start an activity from a
             notification action). exported=true is required so the
             PendingIntent can resolve to it. The activity validates
             the action and the package on every onCreate. -->
        <activity
            android:name=".RecentsActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.miro.a11y.KILL_ALL_RECENT" />
                <action android:name="com.miro.a11y.OPEN_RECENTS" />
            </intent-filter>
        </activity>

        <!-- RecentsOverviewActivity (v1.4.22+): fullscreen custom
             recents UI. Used as the destination for the
             "Abrir recientes" notification action (instead of
             launching the OLAX RecentsActivity which is broken /
             throttled by Quickstep). Lists running tasks, lets
             the user close one or all. launched by RecentsActionActivity
             so it is not directly exported (defense in depth). -->
        <activity
            android:name=".RecentsOverviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Miro.Recents" />

    </application>

</manifest>
