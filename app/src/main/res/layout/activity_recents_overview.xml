<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recents_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header row: title + "Cerrar todas" button + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recents"
            android:textColor="@color/recents_fg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar todas"
            android:textColor="@color/recents_bg"
            android:backgroundTint="@color/recents_accent" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="X"
            android:textColor="@color/recents_fg"
            android:backgroundTint="@color/recents_card" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/recents_fg_dim"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/scrollRecents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/recyclerRecents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/lblEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No hay apps en segundo plano"
        android:textColor="@color/recents_fg_dim"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
